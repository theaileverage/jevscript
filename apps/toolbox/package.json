{
  "name": "@jevscript/toolbox",
  "version": "0.1.0",
  "private": true,
  "description": "jevs toolbox: a local chat, playground, machine viewer and adapter bench for Jevscript",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node server/main.ts",
    "start": "NODE_ENV=production node server/main.ts",
    "demo": "vite build && node demo/main.ts",
    "build": "vite build",
    "test": "vitest run",
    "verify:python-sandbox": "node verification/python-sandbox.ts",
    "test:browser": "vite build && vitest run -c vitest.browser.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@jevscript/adapter-claude-code": "link:../../adapters/claude-code",
    "@jevscript/adapter-codex": "link:../../adapters/codex",
    "@lezer/highlight": "1.2.5",
    "jevscript": "link:../../sdk/js",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
