program pb_docs_change

# Learned playbook `pb_docs_change`, version 1, drafted 2026-09-28 from past
# tasks: t1-fix-the-typo-in-the-read, t2-add-a-docs-page-about-in, t3-correct-the-readme-link. It went live after replay verification; review it with
# `cos playbook show pb_docs_change` and turn it off with `cos playbook disable pb_docs_change`.

in request: { text, project }
out plan

task main budget calls 2:
  text = request.text
  applies = text feels "asks to write or correct documentation, comments or a README":
    focus "Whether the request is an instance of this routine procedure, not merely a mention of it."
  plan = { matches: false, playbook: "pb_docs_change" }
  if applies > 0.6:
    plan = {
      matches: true,
      playbook: "pb_docs_change",
      project: "notes-site",
      kind: "ship",
      effort: "medium",
      profile: "default",
      notes: """This is a routine docs change task; this procedure has succeeded 3 times."""
    }
