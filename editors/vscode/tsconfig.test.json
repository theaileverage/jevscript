{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Vitest runs the tests as ES modules; the extension itself is bundled
    // to CommonJS by esbuild.
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
