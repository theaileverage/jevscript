{
  "name": "@jevscript/adapters",
  "version": "0.1.0",
  "private": true,
  "description": "The Jevscript `agent` adapter suite: a shared core and one adapter per agent CLI",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "smoke": "pnpm --filter @jevscript/adapter-core run smoke"
  }
}
