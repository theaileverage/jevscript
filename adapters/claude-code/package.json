{
  "name": "@jevscript/adapter-claude-code",
  "version": "0.1.0",
  "homepage": "https://jevscript.sh",
  "private": true,
  "description": "An `agent` adapter that runs Claude Code in a terminal pane (tmux, Herdr, cmux, Orca or Zellij)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jevscript-adapter-claude-code": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@jevscript/adapter-core": "workspace:*",
    "jevscript": "link:../../sdk/js"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
